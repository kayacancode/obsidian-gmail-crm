{
  "name": "people-graph",
  "version": "0.1.0",
  "private": true,
  "description": "Per-user people graph viewer — force-directed contacts with scores and connection strengths, backed by Cloudflare Workers + D1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute people-graph --file ./schema.sql",
    "db:init:remote": "wrangler d1 execute people-graph --remote --file ./schema.sql",
    "smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260602.1",
    "typescript": "~5.9.3",
    "wrangler": "4.96.0"
  }
}
