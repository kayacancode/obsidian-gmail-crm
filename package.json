{
	"name": "obsidian-gmail-crm",
	"version": "1.0.6",
	"description": "Bring Gmail activity, meeting history, and people notes together to understand your relationships, find reasons to reconnect, and explore personal and shared networks.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"build:peoplegraph": "cargo build --release --manifest-path crates/peoplegraph/Cargo.toml",
		"package:peoplegraph": "node scripts/copy-peoplegraph.mjs",
		"peoplegraph:telegram-review": "node scripts/peoplegraph-telegram-review.mjs",
		"test:intelligence": "node scripts/test-intelligence.mjs",
		"preview:intelligence": "node scripts/preview-intelligence.mjs",
		"typecheck": "tsc --noEmit",
		"package:plugin": "node scripts/package-plugin.mjs",
		"check:release": "npm run check:contracts && npm run lint && npm run test:intelligence && npm run typecheck && npm run build && npm run package:plugin",
		"lint": "eslint src",
		"check:contracts": "node scripts/check-service-contracts.mjs",
		"check:services": "npm --prefix services/apps/people-graph run typecheck && npm --prefix services/apps/people-graph test && npm --prefix services/apps/reconnect-web run typecheck"
	},
	"keywords": [
		"obsidian",
		"gmail",
		"crm"
	],
	"author": "Kaya Jones",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@eslint/json": "0.14.0",
		"@microsoft/eslint-plugin-sdl": "^1.1.0",
		"@types/node": "^25.5.0",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"@typescript-eslint/utils": "^8.72.2",
		"esbuild": "^0.27.4",
		"eslint": "^9.39.4",
		"eslint-plugin-depend": "^1.5.0",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"globals": "^16.5.0",
		"obsidian": "^1.14.4",
		"tslib": "^2.8.1",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0"
	}
}
